# Copie para .env.cloud (ignorado pelo Git). Nunca envie chaves/senhas pelo chat.
# Supabase Connect > Session pooler (IPv4), porta 5432, banco postgres.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Project URL e Secret key (sb_secret_...), somente backend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=portal-arquivos
