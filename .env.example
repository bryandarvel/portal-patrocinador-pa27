# Copie para .env e preencha valores exclusivos desta máquina.
# A chave JWT deve conter pelo menos 32 bytes. Nunca publique o arquivo .env.
PORTAL_JWT_SECRET=
PORTAL_BOOTSTRAP_ENABLED=true
PORTAL_BOOTSTRAP_NAME=Administrador local
PORTAL_BOOTSTRAP_EMAIL=admin@portal.local
# Pelo menos 12 caracteres; só usado para criar o primeiro administrador.
PORTAL_BOOTSTRAP_PASSWORD=
# Portas publicadas no host. Altere só se alguma já estiver em uso nesta máquina.
FRONTEND_PORT=4200
BACKEND_PORT=8080
MAILPIT_PORT=8025
# Senha dos usuários criados por backend/scripts/seed-portal.py; vazia usa PORTAL_BOOTSTRAP_PASSWORD.
PORTAL_SEED_PASSWORD=
